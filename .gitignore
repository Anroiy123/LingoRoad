# JetBrains IDE config
.idea/

.agents
.codex
# This machine's global gitignore excludes .claude/ and CLAUDE.md
# everywhere; this repo tracks them deliberately (Claude Code context
# docs), except the local settings file below, which can carry
# machine-specific secrets.
!/.claude/
/.claude/settings.local.json
!/CLAUDE.md
context.md
/docs/superpowers/
/.worktrees/

# Android signing material
src/mobile/android/key.properties
src/mobile/android/app/*.jks
src/mobile/android/app/*.keystore
deploy/.env.production
