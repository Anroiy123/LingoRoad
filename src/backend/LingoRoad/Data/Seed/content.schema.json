{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingoroad.local/schemas/content-bundle.json",
  "title": "LingoRoad versioned content bundle",
  "type": "object",
  "required": ["version", "source", "license", "reviewer", "lessons"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "lessons": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "titleVi", "skillCode", "cefr", "order", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^lesson-[a-z0-9-]+$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "titleVi": { "type": "string", "minLength": 1 },
          "descriptionVi": { "type": ["string", "null"] },
          "skillCode": { "type": "string", "minLength": 1 },
          "cefr": { "enum": ["A1", "A2", "B1", "B2"] },
          "order": { "type": "integer", "minimum": 1 },
          "items": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "type", "stem", "options", "correctAnswer"],
              "properties": {
                "id": { "type": "string", "pattern": "^item-[a-z0-9-]+$" },
                "type": { "enum": ["mcq", "cloze", "reorder"] },
                "stem": { "type": "string", "minLength": 1 },
                "options": { "type": "array", "items": { "type": "string" } },
                "correctAnswer": { "type": "string", "minLength": 1 },
                "explanationVi": { "type": ["string", "null"] },
                "audioUrl": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
