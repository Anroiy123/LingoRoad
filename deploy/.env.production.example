DOMAIN=learn.example.com
ACME_EMAIL=ops@example.com
API_IMAGE=ghcr.io/example/lingoroad-api:COMMIT_SHA
ML_IMAGE=ghcr.io/example/lingoroad-ml:COMMIT_SHA
ADMIN_IMAGE=ghcr.io/example/lingoroad-admin:COMMIT_SHA
POSTGRES_DB=lingoroad
POSTGRES_USER=lingoroad
POSTGRES_PASSWORD=replace-with-secret
JWT_ISSUER=lingoroad-production
JWT_SECRET=replace-with-at-least-32-random-bytes
ML_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
ML_REQUIRED_MODELS=cat
MINIO_ROOT_USER=replace-with-secret
MINIO_ROOT_PASSWORD=replace-with-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-secret
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=replace-with-at-least-12-characters
